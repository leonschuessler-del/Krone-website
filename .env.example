# ---------------------------------------------------------------------------
# Zur Krone – Umgebungsvariablen
# Kopieren nach `.env.local` und Werte eintragen. NIEMALS echte Secrets committen.
# ---------------------------------------------------------------------------

# Datenbank (PostgreSQL). Leer lassen => eingebettete Dev-Datenbank (PGlite)
# unter ./.data/pglite – ideal zum lokalen Ausprobieren ohne Postgres-Installation.
# Produktion: echte PostgreSQL-Instanz (z. B. Neon, Supabase, RDS, eigener Server).
DATABASE_URL=

# Secret für Admin-Sessions (mind. 32 Zeichen). Erzeugen z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Öffentliche Basis-URL (für Sitemap, OpenGraph, Zahlungs-Redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo-Modus: Demo-Verfügbarkeiten, Demo-Preise (klar gekennzeichnet),
# simulierte Zahlungen, E-Mails nur als Vorschau. In Produktion auf false setzen.
DEMO_MODE=true

# Zahlungsanbieter: "demo" | "stripe" | "none" (nur Anfragen, keine Zahlung)
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# E-Mail-Versand: "preview" (nur speichern/anzeigen, nichts wird versendet) | "resend"
EMAIL_PROVIDER=preview
EMAIL_API_KEY=
EMAIL_FROM=
# Empfänger für Betreiber-Benachrichtigungen (neue Anfragen/Buchungen)
EMAIL_OPERATOR_TO=

# Optional: Admin-Zugang beim Seed anlegen. Ohne Passwort wird ein zufälliges
# Passwort erzeugt und einmalig in der Konsole ausgegeben.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: Cron-Secret für /api/cron/* (abgelaufene Reservierungen freigeben)
CRON_SECRET=

# Migrationen + Basis-/Demo-Seed automatisch beim ersten Datenbankzugriff
# ausführen (Standard: true). Für streng kontrollierte Produktionsumgebungen
# auf false setzen und stattdessen "npm run db:migrate" im Deployment nutzen.
AUTO_MIGRATE=true
